{
  "name": "tarot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "pnpm --filter @tarot/shared build && pnpm --filter @tarot/web dev",
    "build": "pnpm --filter @tarot/shared build && pnpm --filter @tarot/web build",
    "build:cards": "pnpm --filter @tarot/shared build && node scripts/build-cards.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "vitest": "^5.0.3"
  }
}
